<Project Sdk="Microsoft.NET.Sdk">
  <!--
    BepInEx 5 (Unity Mono) eklenti şablonu.
    Derleme:  dotnet build -c Release -p:OyunKlasoru="C:\Steam\steamapps\common\OyunAdi"
    Çıktı:    bin/Release/netstandard2.1/OrnekMod.dll  ->  <Oyun>/BepInEx/plugins/ altına kopyalayın.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>OrnekMod</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Oyunun klasörü; komut satırından -p:OyunKlasoru=... ile verin. -->
    <OyunKlasoru Condition="'$(OyunKlasoru)' == ''">$(MSBuildProjectDirectory)\..\oyun</OyunKlasoru>
    <!-- "<OyunAdi>_Data" klasörünün adı; oyunun exe adıyla aynıdır. -->
    <OyunVeriKlasoru Condition="'$(OyunVeriKlasoru)' == ''">OyunAdi_Data</OyunVeriKlasoru>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <!-- Sürümü oyunun Unity sürümüne yaklaştırın (ör. 2021.3.x, 2022.3.x). -->
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.*" IncludeAssets="compile" />
  </ItemGroup>

  <!-- Oyunun kendi kodu. Harmony yamaları için gerekir; oyun klasörü verilmediyse atlanır. -->
  <ItemGroup Condition="Exists('$(OyunKlasoru)\$(OyunVeriKlasoru)\Managed\Assembly-CSharp.dll')">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(OyunKlasoru)\$(OyunVeriKlasoru)\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
